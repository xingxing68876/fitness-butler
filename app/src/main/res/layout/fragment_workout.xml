<?xml version="1.0" encoding="utf-8"?>
<!-- 锻炼指导(M2.5 打卡制):日期切换打卡清单(当日可勾/过期变黑/未来绿禁勾)+ 动作库 tab -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mint"
    android:orientation="vertical"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:paddingTop="18dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="锻炼打卡"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/workout_swap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_tag_out"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="换默认模板"
            android:textColor="@color/ink"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/workout_ai_plan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_ink"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="✨ AI 对话定制"
            android:textColor="@color/paper"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 当前计划名 -->
    <TextView
        android:id="@+id/workout_plan_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="当前计划 · 新手增肌周计划"
        android:textColor="@color/gray_text"
        android:textSize="11sp" />

    <!-- 打卡 / 动作库 两个 tab -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/workout_tab_checkin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_tag_ink"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="今日打卡"
            android:textColor="@color/paper"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/workout_tab_lib"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_out"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="动作库"
            android:textColor="@color/ink"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 日期切换条(打卡 tab):◀ 日期胶囊横滑 ▶ -->
    <LinearLayout
        android:id="@+id/workout_date_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/workout_prev_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="◀"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/workout_dates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/workout_next_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="▶"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 打卡区(打卡 tab):日期标题+进度,清单 -->
    <LinearLayout
        android:id="@+id/workout_checkin_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/workout_date_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="今天 · 10月17日 周五   0/5"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/workout_checkin_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:listSelector="@android:color/transparent" />
    </LinearLayout>

    <!-- 动作库区(库 tab):分类胶囊+列表 -->
    <LinearLayout
        android:id="@+id/workout_lib_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/workout_cats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ListView
            android:id="@+id/workout_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:listSelector="@android:color/transparent" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="当日可勾 · 过期定格 · 未来预览;伤病史先问医生,量力而行"
        android:textColor="@color/gray_text"
        android:textSize="10sp" />
</LinearLayout>
